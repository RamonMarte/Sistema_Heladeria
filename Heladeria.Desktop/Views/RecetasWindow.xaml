<Window x:Class="Heladeria.Desktop.Views.RecetasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Heladeria.Desktop.Views"
        mc:Ignorable="d"
        Title="Recetas y consumo de inventario"
        Height="760"
        Width="1150"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="AlternationCount" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Recetas y consumo"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#183B56"/>

                <TextBlock
                    Text="Configura cuánto ingrediente y material consume cada producto vendido."
                    TextWrapping="Wrap"
                    Foreground="#64748B"
                    Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="← Volver al menú"
                    Background="#E2E8F0"
                    Foreground="#243047"
                    Click="Volver_Click"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- SELECCIONAR PRESENTACIÓN -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Producto y presentación vendible"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding Presentaciones}"
                              SelectedItem="{Binding PresentacionSeleccionada}"
                               IsEnabled="{Binding PuedeSeleccionarPresentacion}"
                              DisplayMemberPath="NombreCompleto"
                              Height="38"
                              Padding="6"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Cargar receta"
                        Command="{Binding CargarRecetaCommand}"
                        Background="#2563EB"
                        Foreground="White"
                        Margin="0,22,8,0"/>

                <Button Grid.Column="2"
                        Content="Actualizar opciones"
                        Command="{Binding CargarCommand}"
                        Background="#E2E8F0"
                        Foreground="#243047"
                        Margin="0,22,0,0"/>
            </Grid>
        </Border>

        <!-- AGREGAR COMPONENTES -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Agregar ingrediente o material"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#183B56"
                           Margin="0,0,0,12"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Artículo de inventario"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding ArticulosDisponibles}"
                                  SelectedItem="{Binding ArticuloSeleccionado}"
                                  DisplayMemberPath="Nombre"
                                  Height="36"
                                  Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">
                        <TextBlock Text="Consumo por unidad"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding CantidadNuevaTexto,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="+ Agregar"
                            Command="{Binding AgregarIngredienteCommand}"
                            Background="#0F766E"
                            Foreground="White"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
        </Border>

        <!-- TABLA DE LA RECETA -->

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Componentes de la receta"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#183B56"/>

                    <TextBlock
                        Text="Puedes editar la cantidad directamente en la tabla. Los cambios se guardan al pulsar Guardar receta."
                        Foreground="#64748B"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding IngredientesReceta}"
                          SelectedItem="{Binding LineaSeleccionada,
                                                 Mode=TwoWay}"
                          IsReadOnly="False">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Ingrediente o material"
                            Binding="{Binding NombreArticulo}"
                            IsReadOnly="True"
                            Width="*"/>

                        <DataGridTextColumn
                            Header="Tipo"
                            Binding="{Binding TipoArticulo}"
                            IsReadOnly="True"
                            Width="150"/>

                        <DataGridTextColumn
                            Header="Unidad"
                            Binding="{Binding Abreviatura}"
                            IsReadOnly="True"
                            Width="100"/>

                        <DataGridTextColumn
                            Header="Cantidad por unidad vendida"
                            Binding="{Binding CantidadTexto,
                                              UpdateSourceTrigger=PropertyChanged}"
                            Width="230"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">

                    <Button Content="Quitar seleccionado"
                            Command="{Binding QuitarIngredienteCommand}"
                            Background="#FEE2E2"
                            Foreground="#991B1B"
                            Margin="0,0,10,0"/>

                    <Button Content="Guardar receta"
                            Command="{Binding GuardarRecetaCommand}"
                            Background="#2563EB"
                            Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MENSAJE -->

        <TextBlock Grid.Row="4"
                   Text="{Binding Mensaje}"
                   TextWrapping="Wrap"
                   Foreground="#2563EB"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
