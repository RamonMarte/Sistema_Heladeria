<Window x:Class="Heladeria.Desktop.Views.CajasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Heladeria.Desktop.Views"
        mc:Ignorable="d"
        Title="Gestión de cajas"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Gestión de cajas"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#243047"/>

                <TextBlock Text="Administra los puntos de cobro de la heladería"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="← Volver"
                    Padding="14,9"
                    Background="#E2E8F0"
                    Foreground="#243047"
                    BorderThickness="0"
                    Click="Volver_Click"
                    VerticalAlignment="Center"/>

        </Grid>

        <!-- FORMULARIO -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="3"
                           Text="Datos de la caja"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#243047"
                           Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,12,14">

                    <TextBlock Text="Código"
                               Foreground="#475569"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding Codigo,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="30"
                             Height="36"
                             Padding="8"
                             VerticalContentAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,12,14">

                    <TextBlock Text="Nombre de la caja"
                               Foreground="#475569"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding Nombre,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80"
                             Height="36"
                             Padding="8"
                             VerticalContentAlignment="Center"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,14">

                    <CheckBox Content="Caja activa"
                              IsChecked="{Binding Activa}"
                              VerticalAlignment="Center"
                              Margin="0,0,0,10"/>

                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal">

                    <Button Content="{Binding TextoBotonGuardar}"
                            Command="{Binding GuardarCommand}"
                            Padding="18,10"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"/>

                    <Button Content="Nueva caja"
                            Command="{Binding NuevoCommand}"
                            Padding="18,10"
                            Background="#E2E8F0"
                            Foreground="#243047"
                            BorderThickness="0"/>

                    <Button Content="Actualizar lista"
                            Command="{Binding CargarCommand}"
                            Padding="18,10"
                            Background="#0F766E"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="10,0,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- LISTADO -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <DataGrid ItemsSource="{Binding Cajas}"
                      SelectedItem="{Binding CajaSeleccionada, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding CajaId}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Código"
                                        Binding="{Binding Codigo}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding Nombre}"
                                        Width="*"/>

                    <DataGridCheckBoxColumn Header="Activa"
                                            Binding="{Binding Activa}"
                                            Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- ESTADO -->

        <TextBlock Grid.Row="3"
                   Text="{Binding Mensaje}"
                   Foreground="#2563EB"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

    </Grid>
</Window>
