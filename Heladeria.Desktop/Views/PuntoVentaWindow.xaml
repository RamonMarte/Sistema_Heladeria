<Window x:Class="Heladeria.Desktop.Views.PuntoVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Heladeria.Desktop.Views"
        mc:Ignorable="d"
        Title="Heladería | Punto de venta"
        Height="760"
        Width="1280"
        MinHeight="650"
        MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="#176B75"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#D6DCE5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0"
                Background="#183B56"
                CornerRadius="12"
                Padding="22,16"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">
                    <TextBlock Text="Punto de venta"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="White"/>

                    <TextBlock Text="Busca, agrega productos y cobra."
                       Foreground="#D8E8F0"
                       Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                   Text="HELADERÍA"
                   FontSize="17"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Margin="12,0,22,0"/>

                <Button Grid.Column="2"
                Content="← Volver al menú"
                Click="Volver_Click"
                Padding="14,10"
                Background="White"
                Foreground="#183B56"
                BorderThickness="0"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Catálogo -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Catálogo de productos"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#1B2838"
                               Margin="0,0,0,12"/>

                    <TextBox Grid.Row="1"
                             Style="{StaticResource CampoTexto}"
                             Margin="0,0,0,12"
                             ToolTip="Buscar por nombre, sabor, presentación o código"
                             Text="{Binding Buscar, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Productos}"
                              IsReadOnly="True"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto"
                                                Binding="{Binding NombreProducto}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Presentación"
                                                Binding="{Binding NombrePresentacion}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Precio"
                                                Binding="{Binding PrecioVenta, StringFormat={}{0:N2}}"
                                                Width="85"/>

                            <DataGridTemplateColumn Header="Agregar"
                                                    Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="+ Agregar"
                                                Padding="5,4"
                                                Command="{Binding DataContext.AgregarCommand,
                                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource BotonPrincipal}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Carrito y cobro -->
            <Border Grid.Column="2"
        Background="White"
        CornerRadius="12"
        Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.4*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado y contador -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Carrito de venta"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="#1B2838"
                       VerticalAlignment="Center"/>

                        <Border Grid.Column="1"
                    Background="#E8F1F4"
                    CornerRadius="12"
                    Padding="10,5">
                            <TextBlock Text="{Binding ResumenCantidadCarrito}"
                           FontWeight="SemiBold"
                           Foreground="#176B75"/>
                        </Border>
                    </Grid>

                    <!-- Carrito -->
                    <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Carrito}"
                  IsReadOnly="False"
                  MinHeight="90"
                  Margin="0,0,0,8">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto"
                                    Binding="{Binding Producto.NombreProducto}"
                                    IsReadOnly="True"
                                    Width="*"/>

                            <DataGridTextColumn Header="Precio"
                                    Binding="{Binding PrecioUnitario, StringFormat={}{0:N2}}"
                                    IsReadOnly="True"
                                    Width="70"/>

                            <DataGridTextColumn Header="Cantidad"
                                    Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                    Width="78"/>

                            <DataGridTextColumn Header="Importe"
                                    Binding="{Binding Importe, StringFormat={}{0:N2}}"
                                    IsReadOnly="True"
                                    Width="80"/>

                            <DataGridTemplateColumn Header="Quitar"
                                        Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                    Command="{Binding DataContext.QuitarCommand,
                                        RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    Padding="5,3"
                                    Foreground="#B42318"
                                    Background="#FEF3F2"
                                    BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Totales -->
                    <Grid Grid.Row="2" Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Subtotal"
                           Foreground="#667085"/>

                            <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N2}}"
                           FontSize="16"
                           FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right">
                            <TextBlock Text="TOTAL"
                           Foreground="#183B56"
                           FontWeight="Bold"/>

                            <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#176B75"/>
                        </StackPanel>
                    </Grid>

                    <!-- Datos de pago: desplazables si falta espacio -->
                    <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                        <Grid Margin="0,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Caja"
                           FontWeight="SemiBold"
                           Margin="0,0,8,5"/>

                            <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="Método de pago"
                           FontWeight="SemiBold"
                           Margin="8,0,0,5"/>

                            <ComboBox Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{Binding Cajas}"
                          SelectedItem="{Binding CajaSeleccionada}"
                          DisplayMemberPath="Nombre"
                          Height="35"
                          Margin="0,0,8,14"/>

                            <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          ItemsSource="{Binding MetodosPago}"
                          SelectedItem="{Binding MetodoPago}"
                          Height="35"
                          Margin="8,0,0,14"/>

                            <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Monto recibido (RD$)"
                           FontWeight="SemiBold"
                           Margin="0,0,8,5"/>

                            <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="Cambio"
                           FontWeight="SemiBold"
                           Margin="8,0,0,5"/>

                            <TextBox Grid.Row="3"
                                 Grid.Column="0"
                                 Text="{Binding MontoRecibidoTexto, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CampoTexto}"
                                 Margin="0,0,8,14"/>

                            <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding Cambio, StringFormat={}{0:N2}}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#176B75"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,14"/>

                            <TextBlock Grid.Row="4"
                               Grid.ColumnSpan="2"
                               Text="Referencia de transferencia (opcional)"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                            <TextBox Grid.Row="5"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CampoTexto}"
                                 Margin="0,0,0,8"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- Botón siempre en su propia fila -->
                    <Button Grid.Row="4"
                        Content="COBRAR VENTA"
                        Command="{Binding CobrarCommand}"
                        Style="{StaticResource BotonPrincipal}"
                        Height="46"
                        Margin="0,10,0,0"
                        FontSize="15"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#E8F1F4"
                CornerRadius="8"
                Padding="12"
                Margin="0,14,0,0">
            <TextBlock Text="{Binding Mensaje}"
                       Foreground="#183B56"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
    
</Window>
